{
  "screener_name": "Multi-Condition Wide Net & Ranked Leaderboard",
  "description": "Yields ~98% of active stocks (~2,750+ stocks across Indian universe). Triggers when ANY bullish condition passes, and automatically sorts the entire universe by composite momentum urgency score.",
  "logic": "OR",
  "conditions": {
    "condition_1": {
      "id": "condition_1",
      "name": "Hourly Close > Daily Open",
      "enabled": true,
      "operator": ">",
      "factor": 1.0,
      "offset": 0.0
    },
    "condition_2": {
      "id": "condition_2",
      "name": "Hourly Close > ([-1] Daily Close * 0.95)",
      "enabled": true,
      "operator": ">",
      "lookback_days": 1,
      "factor": 0.95
    },
    "condition_3": {
      "id": "condition_3",
      "name": "Hourly Close >= [-10] Daily Close",
      "enabled": true,
      "operator": ">=",
      "lookback_days": 10,
      "factor": 1.0
    },
    "condition_4": {
      "id": "condition_4",
      "name": "1day RSI(14) > ([-1] 1day RSI(14) + 1)",
      "enabled": true,
      "operator": ">",
      "rsi_window": 14,
      "lookback_days": 1,
      "rsi_delta": 1.0
    },
    "condition_5": {
      "id": "condition_5",
      "name": "Daily Volume > 5,000,000",
      "enabled": false,
      "operator": ">",
      "min_volume": 5000000.0
    }
  }
}
