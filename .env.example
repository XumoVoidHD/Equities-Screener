# Dhan live market data credentials
DHAN_CLIENT_ID=your_dhan_client_id

# Option A - manual access token (expires in ~24 hours):
DHAN_ACCESS_TOKEN=

# Option B - automatic token minting via PIN + TOTP (recommended; cached in data/dhan/token.json):
DHAN_PIN=your_dhan_pin
DHAN_TOTP_SECRET=your_totp_secret
